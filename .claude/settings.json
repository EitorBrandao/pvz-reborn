{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && git config core.hooksPath tools/hooks && chmod +x tools/hooks/* 2>/dev/null; exit 0" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file|mcp__github__merge_pull_request",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/bloquear-atalho-main.sh" }
        ]
      }
    ]
  }
}
